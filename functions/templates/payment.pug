doctype html
head
  meta(charset='UTF-8')
  title Company
  meta(name='viewport' content='width=device-width, initial-scale=1, shrink-to-fit=no')
  meta(http-equiv='Content-Type' content='text/html charset=UTF-8')
  style.
    body {
    padding: 0;
    margin: 0;
    font-family: 'aril', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
    }
    td {
    padding: 0
    }
    footer {
    font-size: 16px;
    text-align: center;
    }
    .bg {
    background-color: #d6d6d6;
    }
    @media print {
    footer {
    position: fixed;
    bottom: 0;
    }
    .bg {
    background-color: #fff;
    }
    .hidden-print {
    display: none;
    }
div(style='border:1px solid lightgray;')
table(cellpadding='5' cellspacing='0' border='0' width='100%' style='border-spacing: 0;width: 500px;margin: 0 auto;border: 1px solid lightgray;')
